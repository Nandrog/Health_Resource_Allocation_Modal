    "plt.show()\n",
    "\n",
    "# Print the exact numbers\n",
    "print(\"\\n Feature Importance Scores:\")\n",
    "for name, score in zip(feature_names, importances):\n",
    "    print(f\"   - {name}: {score:.2%}\")\n",
    "\n"
   ]
